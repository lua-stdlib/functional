title = 'functional @version@ Reference'
project = 'functional @version@'

description = [[
# Functional Programming with Lua

An immutable tuple object, and many higher-order functions to help
program in a functional style using tuples and Lua tables.

This is a light-weight library for Lua 5.1 (including LuaJIT), 5.2,
5.3, 5.4 and 5.5 written in pure Lua.

## LICENSE

The code is copyright by its authors, and released under the MIT
license (the same license as Lua itself).  There is no warranty.
]]

dir = '../doc'

file = {
  '../lib/std/functional/init.lua',
  '../lib/std/functional/operator.lua',
  '../lib/std/functional/tuple.lua',
}

new_type ('object', 'Objects', false, 'Fields')

format = 'markdown'
backtick_references = false
sort = false
